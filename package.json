{
  "name": "port-manager",
  "version": "1.0.0",
  "description": "Port Manager - Kill and manage processes using network ports on Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "test": "node --test",
    "check:syntax": "node --check main.js && node --check preload.js && node --check src/services/portService.js && node --check src/services/portReference.js && node --check src/renderer/safeMarkup.js && node --check src/renderer/app.js",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "keywords": ["port", "manager", "windows", "netstat", "kill"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.portmanager.app",
    "productName": "Port Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
